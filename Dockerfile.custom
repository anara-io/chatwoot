# Custom Dockerfile that applies our CORS changes to the official Chatwoot image
FROM chatwoot/chatwoot:latest-ce

# Copy our modified CORS configuration
COPY config/initializers/cors.rb /app/config/initializers/cors.rb

# Install additional packages
RUN apk add --no-cache multirun postgresql-client

# Set environment variables to ensure our CORS settings are used
ENV CW_CORS_ALLOWED_ORIGINS='*'
ENV CW_ENABLE_API_ACCESS=true

# Default command from the original image
CMD ["bundle", "exec", "rails", "s", "-p", "3000", "-b", "0.0.0.0"]
